# ==============================================================================
# AWS Data Engineering Local Development Environment Configuration
# Copy this file to .env before starting the Docker Compose stack:
#   cp .env.example .env
# ==============================================================================

# Docker Compose Project Namespace
COMPOSE_PROJECT_NAME=de_base_workspace

# Airflow Host User ID (matches standard airflow user inside container)
AIRFLOW_UID=50000

# Service Port Mapping (Host:Container)
AIRFLOW_PORT=8080
GLUE_JUPYTER_PORT=8888
SPARK_UI_PORT=4040
SPARK_HISTORY_PORT=18080
LIVY_PORT=8998

# PostgreSQL Configuration for Airflow Metadata Backend
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# Airflow Security Key (Generated fernet key for metadata encryption)
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFfDewgnbL3hOHop8=

# Airflow Webserver Admin Credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_AIRFLOW_WWW_USER_EMAIL=airflow@example.com
_AIRFLOW_WWW_USER_FIRSTNAME=Airflow
_AIRFLOW_WWW_USER_LASTNAME=Admin

# ==============================================================================
# AWS Cloud Configuration (S3, Glue Data Catalog, Crawler & Amazon Athena)
# ==============================================================================
# AWS CLI Profile (mapped from your host ~/.aws credentials)
AWS_PROFILE=giduturi-tutorial-profile

# AWS Region
AWS_DEFAULT_REGION=ap-south-1

# Target Real AWS S3 Data Buckets (Set to your actual AWS bucket names)
S3_RAW_BUCKET=your-actual-aws-s3-bucket-name
S3_PROCESSED_BUCKET=your-actual-aws-s3-bucket-name
S3_CURATED_BUCKET=your-actual-aws-s3-bucket-name

# AWS Glue Data Catalog & Crawler
GLUE_DATABASE_NAME=ecommerce_db
GLUE_CRAWLER_NAME=ecommerce_orders_crawler

# Amazon Athena Configuration
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-actual-aws-s3-bucket-name/athena_query_results/
